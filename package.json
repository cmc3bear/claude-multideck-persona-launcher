{
  "name": "claude-multideck-persona-launcher",
  "version": "0.9.2",
  "description": "MultiDeck: forkable multi-agent coordination framework for Claude Code with personas, cyberpunk launcher, Kokoro TTS, and OQE-disciplined job board",
  "main": "dispatch-framework/dashboard/server.cjs",
  "scripts": {
    "start": "node dispatch-framework/dashboard/server.cjs",
    "dashboard": "node dispatch-framework/dashboard/server.cjs",
    "job:list": "python dispatch-framework/scripts/job-board.py list",
    "job:create": "python dispatch-framework/scripts/job-board.py create",
    "agent:list": "python dispatch-framework/scripts/dispatch-agent.py list",
    "agent:add": "python dispatch-framework/scripts/dispatch-agent.py add",
    "review": "python dispatch-framework/scripts/reviewer-review.py",
    "typer:source": "python dispatch-framework/hooks/hacker-typer-source.py",
    "typer:terminal": "python dispatch-framework/hooks/hacker-typer-terminal.py",
    "typer:launch": "powershell -ExecutionPolicy Bypass -File dispatch-framework/scripts/launch-hacker-typer.ps1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cmc3bear/claude-multideck-persona-launcher.git"
  },
  "author": "",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "multi-agent",
    "personas",
    "tts",
    "kokoro",
    "launcher"
  ],
  "devDependencies": {
    "puppeteer-core": "^24.41.0"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
